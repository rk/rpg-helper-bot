# Copy to .env and adjust for your setup.

# Chat (rules Q&A)
# Provider: llama.cpp | ollama
RPG_HELPER_CHAT_PROVIDER=llama.cpp
RPG_HELPER_CHAT_MODEL=local-model
# Optional URL override (defaults: llama.cpp http://127.0.0.1:8080/v1, ollama http://127.0.0.1:11434/v1)
# RPG_HELPER_CHAT_URL=http://127.0.0.1:8080/v1

# Embeddings (hybrid search rerank)
# Provider: ollama | llama.cpp | hash
RPG_HELPER_EMBED_PROVIDER=ollama
RPG_HELPER_EMBED_MODEL=nomic-embed-text
# Optional URL override (defaults: ollama http://127.0.0.1:11434, llama.cpp http://127.0.0.1:8080/v1)
# RPG_HELPER_EMBED_URL=http://127.0.0.1:11434

# RPG concept cheatsheet (canonical features + synonyms for glossary/indexing)
# RPG_HELPER_CONCEPTS_FILE=data/rpg-concepts.yaml

# App data directory (SQLite DB, uploaded PDFs, thumbnails). Default: data/ in repo root.
# RPG_HELPER_DATA_DIR=data

# LLM system prompts (optional overrides; defaults in prompts/)
# RPG_HELPER_PROMPTS_DIR=prompts
# RPG_HELPER_PROMPT_RPG_DOMAIN=prompts/shared/rpg-domain.md
# RPG_HELPER_PROMPT_CHAT=prompts/chat-system.md
# RPG_HELPER_PROMPT_SEARCH_REWRITE=prompts/search-rewrite-system.md
# RPG_HELPER_PROMPT_GLOSSARY=prompts/glossary-extract-system.md
# RPG_HELPER_PROMPT_FEATURE_DETECT=prompts/feature-detect-system.md
# RPG_HELPER_PROMPT_CHEATSHEET=prompts/cheatsheet-extract-system.md

# Optional: explicit path to env file
# RPG_HELPER_ENV_FILE=/path/to/.env

# Server ports
# RPG_HELPER_GM_PORT=8765
# RPG_HELPER_PLAYER_PORT=8766
